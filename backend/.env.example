# ─── Application ───────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=false

# ─── Database (PostgreSQL) ─────────────────────────────────────
# Docker Compose injects DATABASE_URL automatically.
# For local dev with SQLite, uncomment:
# DATABASE_URL=sqlite+aiosqlite:///./data/wonderai.db
POSTGRES_PASSWORD=your-strong-postgres-password

# ─── JWT ───────────────────────────────────────────────────────
# SECRET_KEY (above) is used as the JWT signing key.
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ─── AI Provider: "openai", "ollama", or "gemini" ─────────────
AI_PROVIDER=openai

# Option A: OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Option B: Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=mistral

# Option C: Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# ─── CORS (comma-separated for multiple origins) ──────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
